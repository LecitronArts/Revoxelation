#version 450
#extension GL_KHR_shader_subgroup_ballot : enable
#extension GL_KHR_shader_subgroup_basic : enable

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// -----------------------------------------------------------------------
// GpuMeshlet (64 bytes, matches Rust #[repr(C)] layout)
// -----------------------------------------------------------------------
struct GpuMeshlet {
    vec3 center;           // bounding sphere center (local-space)
    float radius;          // bounding sphere radius
    vec3 cone_axis;        // orientation cone axis (normalized)
    float cone_cutoff;     // cos(half-angle); < -1.0 means degenerate (never cull)
    uint vertex_offset;    // into meshlet_vertex_buffer
    uint triangle_offset;  // into meshlet_tri_buffer
    uint vertex_count;     // max 64
    uint triangle_count;   // max 124
    uint chunk_slot;       // which chunk this meshlet belongs to
    uint lod_level;        // LOD level
    uint pad0;
    uint pad1;
};

// -----------------------------------------------------------------------
// SSBO bindings (shared bindless set 0)
// -----------------------------------------------------------------------

// binding 10: meshlet metadata SSBO (read)
layout(std430, set = 0, binding = 10) readonly buffer MeshletMetaBuffer {
    // 16 uint32 per GpuMeshlet = 64 bytes
    uint data[];
} meshlet_meta;

// binding 4: frustum planes SSBO (read) - 6 vec4 planes = 96 bytes
layout(std430, set = 0, binding = 4) readonly buffer FrustumPlanesBuffer {
    vec4 frustum_planes[6];
} frustum;

// binding 6: Hi-Z occlusion culling config
layout(std430, set = 0, binding = 6) readonly buffer HiZConfigBuffer {
    mat4 view_proj;       // view-projection matrix
    vec2 hiz_size;        // Hi-Z mip 0 dimensions (width, height)
    uint hiz_enabled;     // Runtime toggle
    uint hiz_mip_count;   // Number of mip levels
} hiz_config;

// binding 7: Hi-Z depth pyramid (combined image sampler)
layout(set = 0, binding = 7) uniform sampler2D hiz_pyramid;

// binding 13: visible meshlet output (write)
layout(std430, set = 0, binding = 13) buffer VisibleMeshletBuffer {
    uint visible_meshlets[];
} visible_out;

// binding 14: meshlet indirect draw commands (write)
// Each visible meshlet gets one DrawIndexedIndirectCommand (5 x uint32 = 20 bytes).
layout(std430, set = 0, binding = 14) buffer MeshletIndirectBuffer {
    // Packed as 5 consecutive uint32 per command:
    //   [0] indexCount, [1] instanceCount, [2] firstIndex,
    //   [3] vertexOffset, [4] firstInstance
    uint commands[];
} indirect_out;

// binding 15: meshlet count (read+write) — single u32
layout(std430, set = 0, binding = 15) buffer MeshletCountBuffer {
    uint meshlet_count;
} count_buf;

// -----------------------------------------------------------------------
// Push constants (D-02 extended to 32 bytes with camera_pos)
// -----------------------------------------------------------------------
layout(push_constant) uniform PushConstants {
    uint total_meshlet_count;
    uint enable_backface;   // 0 or 1
    uint enable_frustum;    // 0 or 1
    uint enable_hiz;        // 0 or 1
    vec3 camera_pos;        // world-space camera position for backface test
    uint _pad;
} pc;

// -----------------------------------------------------------------------
// GpuMeshlet loader — reads from raw uint array
// -----------------------------------------------------------------------
const uint MESHLET_UINT32S = 16u; // 64 bytes / 4

GpuMeshlet load_meshlet(uint meshlet_id) {
    uint base = meshlet_id * MESHLET_UINT32S;
    GpuMeshlet m;
    m.center = vec3(
        uintBitsToFloat(meshlet_meta.data[base + 0]),
        uintBitsToFloat(meshlet_meta.data[base + 1]),
        uintBitsToFloat(meshlet_meta.data[base + 2])
    );
    m.radius          = uintBitsToFloat(meshlet_meta.data[base + 3]);
    m.cone_axis = vec3(
        uintBitsToFloat(meshlet_meta.data[base + 4]),
        uintBitsToFloat(meshlet_meta.data[base + 5]),
        uintBitsToFloat(meshlet_meta.data[base + 6])
    );
    m.cone_cutoff      = uintBitsToFloat(meshlet_meta.data[base + 7]);
    m.vertex_offset    = meshlet_meta.data[base + 8];
    m.triangle_offset  = meshlet_meta.data[base + 9];
    m.vertex_count     = meshlet_meta.data[base + 10];
    m.triangle_count   = meshlet_meta.data[base + 11];
    m.chunk_slot       = meshlet_meta.data[base + 12];
    m.lod_level        = meshlet_meta.data[base + 13];
    m.pad0             = meshlet_meta.data[base + 14];
    m.pad1             = meshlet_meta.data[base + 15];
    return m;
}

// -----------------------------------------------------------------------
// Culling tests
// -----------------------------------------------------------------------

/// Backface culling via orientation cone (D-03).
/// Returns true if the meshlet is CULLED (backfacing).
bool backface_cull(GpuMeshlet m) {
    // Degenerate cone: cone_cutoff < -1.0 means the meshlet spans more than
    // a hemisphere — never cull it via backface.
    if (m.cone_cutoff < -1.0) {
        return false;
    }
    vec3 to_camera = normalize(pc.camera_pos - m.center);
    return dot(m.cone_axis, to_camera) < m.cone_cutoff;
}

/// Frustum culling: bounding sphere vs 6 frustum planes (D-04).
/// Returns true if the meshlet is CULLED (outside frustum).
bool frustum_cull(GpuMeshlet m) {
    for (int i = 0; i < 6; i++) {
        vec4 plane = frustum.frustum_planes[i];
        float dist = dot(plane.xyz, m.center) + plane.w;
        if (dist < -m.radius) {
            return true; // sphere entirely outside this plane
        }
    }
    return false;
}

/// Hi-Z occlusion culling: project bounding sphere to screen-space rect,
/// sample depth pyramid at appropriate mip, compare (D-05).
/// Returns true if the meshlet is CULLED (occluded).
bool hiz_cull(GpuMeshlet m) {
    // Project sphere center to clip space.
    vec4 clip_center = hiz_config.view_proj * vec4(m.center, 1.0);

    // Behind near plane — can't reliably occlude, don't cull.
    if (clip_center.w <= 0.0) {
        return false;
    }

    vec3 ndc_center = clip_center.xyz / clip_center.w;

    // Project sphere radius to screen space (approximate).
    // radius_ndc ≈ radius / distance_to_camera (in NDC)
    float radius_ndc = m.radius / clip_center.w;

    // Screen-space bounding rect in UV [0,1] coordinates.
    vec2 uv_center = ndc_center.xy * 0.5 + 0.5;
    vec2 uv_half = vec2(radius_ndc * 0.5);

    vec2 uv_min = clamp(uv_center - uv_half, vec2(0.0), vec2(1.0));
    vec2 uv_max = clamp(uv_center + uv_half, vec2(0.0), vec2(1.0));

    // Inflate by 1 texel (conservative).
    vec2 texel_size = 1.0 / hiz_config.hiz_size;
    uv_min -= texel_size;
    uv_max += texel_size;
    uv_min = clamp(uv_min, vec2(0.0), vec2(1.0));
    uv_max = clamp(uv_max, vec2(0.0), vec2(1.0));

    // Determine mip level.
    vec2 rect_size = (uv_max - uv_min) * hiz_config.hiz_size;
    float max_rect_dim = max(rect_size.x, rect_size.y);
    float mip_level = max_rect_dim > 0.0 ? ceil(log2(max_rect_dim)) : 0.0;
    mip_level = clamp(mip_level, 0.0, float(hiz_config.hiz_mip_count - 1u));

    // Sample 4 corners.
    float d00 = textureLod(hiz_pyramid, uv_min, mip_level).r;
    float d10 = textureLod(hiz_pyramid, vec2(uv_max.x, uv_min.y), mip_level).r;
    float d01 = textureLod(hiz_pyramid, vec2(uv_min.x, uv_max.y), mip_level).r;
    float d11 = textureLod(hiz_pyramid, uv_max, mip_level).r;
    float max_depth = max(max(d00, d10), max(d01, d11));

    // Sphere's nearest depth in NDC.
    float min_z = ndc_center.z - radius_ndc;

    return max_depth < min_z;
}

// -----------------------------------------------------------------------
// main
// -----------------------------------------------------------------------

void main() {
    uint meshlet_id = gl_GlobalInvocationID.x;

    // Out-of-bounds guard.
    if (meshlet_id >= pc.total_meshlet_count) {
        return;
    }

    GpuMeshlet m = load_meshlet(meshlet_id);

    // Skip empty meshlets.
    if (m.triangle_count == 0u) {
        return;
    }

    // Three independent culling tests, each gated by push constant toggle.
    bool culled = false;

    if (pc.enable_backface != 0u && !culled) {
        culled = backface_cull(m);
    }

    if (pc.enable_frustum != 0u && !culled) {
        culled = frustum_cull(m);
    }

    if (pc.enable_hiz != 0u && !culled) {
        culled = hiz_cull(m);
    }

    bool visible = !culled;

    // ---------------------------------------------------------------
    // Subgroup ballot compaction (D-06)
    // One atomicAdd per subgroup instead of per thread.
    // ---------------------------------------------------------------
    uvec4 ballot = subgroupBallot(visible);
    uint local_count = subgroupBallotBitCount(ballot);
    uint local_offset = subgroupBallotExclusiveBitCount(ballot);

    uint global_offset;
    if (subgroupElect()) {
        global_offset = atomicAdd(count_buf.meshlet_count, local_count);
    }
    global_offset = subgroupBroadcastFirst(global_offset);

    if (visible) {
        uint write_idx = global_offset + local_offset;
        visible_out.visible_meshlets[write_idx] = meshlet_id;

        // Emit DrawIndexedIndirectCommand (D-04):
        //   indexCount    = triangle_count * 3
        //   instanceCount = 1
        //   firstIndex    = triangle_offset (into global triangle index buffer bound as IB)
        //   vertexOffset  = vertex_offset (into global vertex buffer bound as VB)
        //   firstInstance = 0 (gl_DrawID auto-provided via VK_KHR_shader_draw_parameters)
        uint cmd_base = write_idx * 5u;
        indirect_out.commands[cmd_base + 0] = m.triangle_count * 3u;  // indexCount
        indirect_out.commands[cmd_base + 1] = 1u;                     // instanceCount
        indirect_out.commands[cmd_base + 2] = m.triangle_offset;      // firstIndex
        indirect_out.commands[cmd_base + 3] = m.vertex_offset;        // vertexOffset (as int32, but unsigned is fine for positive offsets)
        indirect_out.commands[cmd_base + 4] = 0u;                     // firstInstance
    }
}
