#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(push_constant) uniform BlurParams {
    vec2 direction;   // (1,0) for horizontal, (0,1) for vertical
    vec2 texel_size;
    uint pass_index;  // 0 = horizontal, 1 = vertical
    float _pad0;
    float _pad1;
    float _pad2;
} params;

// Dedicated blur descriptor set: binding 0 = sampled input, binding 1 = storage output.
layout(set = 0, binding = 0) uniform sampler2D ao_input;
layout(r8, set = 0, binding = 1) uniform writeonly image2D ao_output;

// 7-tap Gaussian bilateral blur
void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 output_size = imageSize(ao_output);
    if (pixel.x >= output_size.x || pixel.y >= output_size.y) return;

    vec2 uv = (vec2(pixel) + 0.5) * params.texel_size;

    // Gaussian weights for 7-tap kernel (sigma ~= 2.0)
    const float weights[4] = float[4](0.2270270, 0.1945945, 0.1216216, 0.0540540);

    float center_ao = texture(ao_input, uv).r;
    float result = center_ao * weights[0];
    float total_weight = weights[0];

    for (int i = 1; i <= 3; i++) {
        vec2 offset = params.direction * params.texel_size * float(i);

        float ao_pos = texture(ao_input, uv + offset).r;
        float ao_neg = texture(ao_input, uv - offset).r;

        // Bilateral weight: reduce weight for samples with very different AO (preserves edges)
        float w_pos = weights[i] * (1.0 - smoothstep(0.0, 0.1, abs(ao_pos - center_ao)));
        float w_neg = weights[i] * (1.0 - smoothstep(0.0, 0.1, abs(ao_neg - center_ao)));

        result += ao_pos * w_pos + ao_neg * w_neg;
        total_weight += w_pos + w_neg;
    }

    result /= max(total_weight, 0.001);
    imageStore(ao_output, pixel, vec4(result, 0.0, 0.0, 0.0));
}
