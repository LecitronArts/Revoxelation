#version 450
#extension GL_GOOGLE_include_directive : enable

#include "common.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct DrawIndexedIndirectCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int vertexOffset;
    uint firstInstance;
};

// Unified scene_buffer (D-07): single SSBO at binding 0 containing 4 regions.
// We access regions via capacity-derived byte offsets calculated in-shader.
// The buffer is declared as raw uint array for flexible region access.
layout(std430, set = 0, binding = 0) buffer SceneBuffer {
    uint data[];
} scene_buffer;

// binding 4: frustum planes SSBO (read) - 6 vec4 planes = 96 bytes
layout(std430, set = 0, binding = 4) readonly buffer FrustumPlanesBuffer {
    vec4 frustum_planes[6];
} frustum;

// binding 5: draw count buffer (read+write) - single uint32 for visible chunk count
layout(std430, set = 0, binding = 5) buffer DrawCountBuffer {
    uint draw_count;
} draw_count_buf;

// binding 6: Hi-Z occlusion culling config
layout(std430, set = 0, binding = 6) readonly buffer HiZConfigBuffer {
    mat4 view_proj;       // view-projection matrix for screen-space projection
    vec2 hiz_size;        // Hi-Z mip 0 dimensions (width, height)
    uint hiz_enabled;     // Runtime toggle: 1 = enabled, 0 = disabled
    uint hiz_mip_count;   // Number of mip levels in the Hi-Z pyramid
} hiz_config;

// binding 7: Hi-Z depth pyramid (combined image sampler)
layout(set = 0, binding = 7) uniform sampler2D hiz_pyramid;

// Push constants: active_draw_count + capacity (D-08)
layout(push_constant) uniform PushConstants {
    uint active_draw_count;
    uint capacity;
} pc;

// ------------------------------------------------------------------
// Region offset helpers (D-03, D-07)
//
// Scene buffer layout (all sizes in uint32 elements):
//   Region 0: GpuChunkInstance[capacity]           @ offset 0           (12 uint32 per instance)
//   Region 1: DrawIndexedIndirectCommand[capacity] @ after region 0     (5 uint32 per command)
//   Region 2: uint[capacity]                       @ after region 1     (1 uint32 per slot)
//   Region 3: DrawIndexedIndirectCommand[capacity] @ after region 2     (5 uint32 per command)
// All region boundaries are 16-byte (4 uint) aligned.
// ------------------------------------------------------------------

const uint INSTANCE_UINT32S = 16u;  // 64 bytes / 4
const uint INDIRECT_UINT32S = 5u;   // 20 bytes / 4
const uint SLOT_UINT32S     = 1u;   // 4 bytes / 4

uint align_up_4(uint offset) {
    return (offset + 3u) & ~3u;
}

// Region byte offsets in uint32 elements
uint instance_region_offset() {
    return 0u;
}

uint indirect_template_region_offset() {
    uint end = pc.capacity * INSTANCE_UINT32S;
    return align_up_4(end);
}

uint draw_slot_region_offset() {
    uint end = indirect_template_region_offset() + pc.capacity * INDIRECT_UINT32S;
    return align_up_4(end);
}

uint dense_indirect_region_offset() {
    uint end = draw_slot_region_offset() + pc.capacity * SLOT_UINT32S;
    return align_up_4(end);
}

// ------------------------------------------------------------------
// Region accessors
// ------------------------------------------------------------------

GpuChunkInstance load_instance(uint slot_id) {
    uint base = instance_region_offset() + slot_id * INSTANCE_UINT32S;
    GpuChunkInstance inst;
    inst.aabb_min = vec3(
        uintBitsToFloat(scene_buffer.data[base + 0]),
        uintBitsToFloat(scene_buffer.data[base + 1]),
        uintBitsToFloat(scene_buffer.data[base + 2])
    );
    inst.material_id = scene_buffer.data[base + 3];
    inst.aabb_max = vec3(
        uintBitsToFloat(scene_buffer.data[base + 4]),
        uintBitsToFloat(scene_buffer.data[base + 5]),
        uintBitsToFloat(scene_buffer.data[base + 6])
    );
    inst.lod_level = scene_buffer.data[base + 7];
    inst.chunk_origin = vec3(
        uintBitsToFloat(scene_buffer.data[base + 8]),
        uintBitsToFloat(scene_buffer.data[base + 9]),
        uintBitsToFloat(scene_buffer.data[base + 10])
    );
    inst.chunk_scale = uintBitsToFloat(scene_buffer.data[base + 11]);
    inst.spawn_time = uintBitsToFloat(scene_buffer.data[base + 12]);
    inst._pad_fade0 = scene_buffer.data[base + 13];
    inst._pad_fade1 = scene_buffer.data[base + 14];
    inst._pad_fade2 = scene_buffer.data[base + 15];
    return inst;
}

DrawIndexedIndirectCommand load_indirect_template(uint slot_id) {
    uint base = indirect_template_region_offset() + slot_id * INDIRECT_UINT32S;
    DrawIndexedIndirectCommand cmd;
    cmd.indexCount = scene_buffer.data[base + 0];
    cmd.instanceCount = scene_buffer.data[base + 1];
    cmd.firstIndex = scene_buffer.data[base + 2];
    cmd.vertexOffset = int(scene_buffer.data[base + 3]);
    cmd.firstInstance = scene_buffer.data[base + 4];
    return cmd;
}

uint load_draw_slot(uint draw_index) {
    uint base = draw_slot_region_offset() + draw_index * SLOT_UINT32S;
    return scene_buffer.data[base];
}

void store_dense_indirect(uint output_index, DrawIndexedIndirectCommand cmd) {
    uint base = dense_indirect_region_offset() + output_index * INDIRECT_UINT32S;
    scene_buffer.data[base + 0] = cmd.indexCount;
    scene_buffer.data[base + 1] = cmd.instanceCount;
    scene_buffer.data[base + 2] = cmd.firstIndex;
    scene_buffer.data[base + 3] = uint(cmd.vertexOffset);
    scene_buffer.data[base + 4] = cmd.firstInstance;
}

// ------------------------------------------------------------------
// Culling helpers
// ------------------------------------------------------------------

/// Test an AABB against a single frustum plane using the P-vertex method.
/// Returns true if the AABB is entirely outside (culled by) the plane.
bool aabb_outside_plane(vec3 aabb_min, vec3 aabb_max, vec4 plane) {
    // P-vertex: the corner of the AABB most in the direction of the plane normal.
    vec3 p_vertex = vec3(
        plane.x >= 0.0 ? aabb_max.x : aabb_min.x,
        plane.y >= 0.0 ? aabb_max.y : aabb_min.y,
        plane.z >= 0.0 ? aabb_max.z : aabb_min.z
    );
    return dot(plane.xyz, p_vertex) + plane.w < 0.0;
}

/// Hi-Z occlusion test. Projects the AABB to screen space, determines the mip level
/// where the screen-space rect covers at most 2x2 texels, samples the Hi-Z pyramid,
/// and returns true if the chunk is fully occluded.
bool hiz_occluded(vec3 aabb_min, vec3 aabb_max) {
    // Project all 8 AABB corners to clip space and find screen-space AABB.
    vec2 ndc_min = vec2(1.0);
    vec2 ndc_max = vec2(-1.0);
    float min_z = 1.0; // Closest depth of the AABB (NDC)

    for (int i = 0; i < 8; i++) {
        vec3 corner = vec3(
            ((i & 1) != 0) ? aabb_max.x : aabb_min.x,
            ((i & 2) != 0) ? aabb_max.y : aabb_min.y,
            ((i & 4) != 0) ? aabb_max.z : aabb_min.z
        );
        vec4 clip = hiz_config.view_proj * vec4(corner, 1.0);

        // Behind the near plane - chunk straddles near plane, can't occlude.
        if (clip.w <= 0.0) {
            return false;
        }

        vec3 ndc = clip.xyz / clip.w;
        ndc_min = min(ndc_min, ndc.xy);
        ndc_max = max(ndc_max, ndc.xy);
        min_z = min(min_z, ndc.z);
    }

    // Clamp to screen bounds [0, 1] UV space.
    vec2 uv_min = clamp(ndc_min * 0.5 + 0.5, vec2(0.0), vec2(1.0));
    vec2 uv_max = clamp(ndc_max * 0.5 + 0.5, vec2(0.0), vec2(1.0));

    // Inflate by 1 texel (conservative rect to prevent popping).
    vec2 texel_size = 1.0 / hiz_config.hiz_size;
    uv_min -= texel_size;
    uv_max += texel_size;
    uv_min = clamp(uv_min, vec2(0.0), vec2(1.0));
    uv_max = clamp(uv_max, vec2(0.0), vec2(1.0));

    // Determine mip level where the rect covers at most 2x2 texels.
    vec2 rect_size = (uv_max - uv_min) * hiz_config.hiz_size;
    float max_rect_dim = max(rect_size.x, rect_size.y);
    float mip_level = max_rect_dim > 0.0 ? ceil(log2(max_rect_dim)) : 0.0;
    mip_level = clamp(mip_level, 0.0, float(hiz_config.hiz_mip_count - 1u));

    // Sample 4 corners of the rect for a more conservative test.
    float d00 = textureLod(hiz_pyramid, uv_min, mip_level).r;
    float d10 = textureLod(hiz_pyramid, vec2(uv_max.x, uv_min.y), mip_level).r;
    float d01 = textureLod(hiz_pyramid, vec2(uv_min.x, uv_max.y), mip_level).r;
    float d11 = textureLod(hiz_pyramid, uv_max, mip_level).r;
    float max_depth = max(max(d00, d10), max(d01, d11));

    // If the max depth in the rect is less than the AABB's minimum Z,
    // the chunk is fully occluded by nearer geometry.
    return max_depth < min_z;
}

void main() {
    uint dense_index = gl_GlobalInvocationID.x;

    // Out-of-range threads do nothing.
    if (dense_index >= pc.active_draw_count) {
        return;
    }

    uint slot_id = load_draw_slot(dense_index);
    GpuChunkInstance inst = load_instance(slot_id);
    DrawIndexedIndirectCommand command = load_indirect_template(slot_id);

    // Skip empty slots (no geometry).
    if (command.indexCount == 0u) {
        return;
    }

    // Frustum cull: test AABB against all 6 frustum planes.
    vec3 aabb_min = inst.aabb_min;
    vec3 aabb_max = inst.aabb_max;

    bool culled = false;
    for (int i = 0; i < 6; i++) {
        if (aabb_outside_plane(aabb_min, aabb_max, frustum.frustum_planes[i])) {
            culled = true;
            break;
        }
    }

    if (culled) {
        // Chunk is outside the frustum - don't emit a draw command.
        return;
    }

    // Hi-Z occlusion cull: test against the previous frame's depth pyramid.
    if (hiz_config.hiz_enabled != 0u) {
        if (hiz_occluded(aabb_min, aabb_max)) {
            return;
        }
    }

    // Visible: write into the compacted output buffer (dense indirect region).
    uint output_index = atomicAdd(draw_count_buf.draw_count, 1u);
    command.instanceCount = 1u;
    store_dense_indirect(output_index, command);
}
